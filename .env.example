# DevTwin Environment Configuration

# Server Port
PORT=5000

# AI Provider Selection: 'mock' | 'gemini' | 'openai'
AI_PROVIDER=mock

# Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API (Optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Allowed Client Origin
CLIENT_URL=http://localhost:5173
